# Do not fill this in by hand. Generate real values with:
#   carylle-admin init-env > .env
# The server refuses to start if any of the first five are missing.

# --- Server secrets ---------------------------------------------------------
# Master secret that per-agent tokens are derived from.
CARYLLE_AGENT_MASTER_SECRET=
# Bearer token for the operator API (case review, approvals, ledger).
CARYLLE_OPERATOR_TOKEN=
# HMAC key for the tamper-evident action ledger.
CARYLLE_LEDGER_KEY=
# Ed25519 keypair (base64). The server signs commands; agents only hold the public half.
CARYLLE_COMMAND_SIGNING_KEY=
CARYLLE_COMMAND_PUBLIC_KEY=

# --- LLM --------------------------------------------------------------------
# Optional. Without credentials every case goes through the deterministic scorer.
ANTHROPIC_API_KEY=
# CARYLLE_LLM_ENABLED=false

# --- Response ---------------------------------------------------------------
# observe | approve | autonomous. Overrides config/settings.yaml at first start.
# CARYLLE_RESPONSE_MODE=approve

# --- TLS --------------------------------------------------------------------
# Create a bootstrap certificate with: carylle-admin gen-cert --host your.server --out deploy/tls
# CARYLLE_TLS_CERT=deploy/tls/cert.pem
# CARYLLE_TLS_KEY=deploy/tls/key.pem

# --- Agent (set on each endpoint, not on the server) ------------------------
# Issue a token with: carylle-admin agent-token <agent-id>
# CARYLLE_SERVER_URL=https://carylle.example.internal:8443
# CARYLLE_AGENT_ID=web-01
# CARYLLE_AGENT_TOKEN=
# CARYLLE_COMMAND_PUBLIC_KEY=
